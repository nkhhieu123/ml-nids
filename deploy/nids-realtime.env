# Cấu hình dịch vụ nids-realtime (chép vào /etc/ml-nids/nids-realtime.env rồi sửa cho lab).
# Card nhận traffic từ cổng mirror (xem docs/59, docs/60: kiểm tra hai chiều trước khi chạy)
NIDS_IFACE=eth1
# File cấu hình: quyết định bộ mô hình và chế độ pipeline. Trên mạng lab dùng config/lab.yaml (mô hình học lại
# trên lab, chế độ doc_lap, QĐ-068; cần chép thư mục models/lab/ sang máy này). config/default.yaml là mô hình
# học từ CIC-IDS2017 và CTU-13, chỉ dùng khi thử trên các bộ dữ liệu đó.
NIDS_CONFIG=/opt/ml-nids/config/lab.yaml
# Tham số thêm cho python -m nids.realtime: mạng giám sát, ghi điểm... (chế độ lấy từ file cấu hình)
NIDS_ARGS=--net 192.168.50.0/24
