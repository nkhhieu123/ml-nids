# Cấu hình dịch vụ nids-realtime (chép vào /etc/ml-nids/nids-realtime.env rồi sửa cho lab).
# Card nhận traffic từ cổng mirror (xem docs/59, docs/60: kiểm tra hai chiều trước khi chạy)
NIDS_IFACE=eth1
# Tham số thêm cho python -m nids.realtime: mạng giám sát, chế độ, ghi điểm...
NIDS_ARGS=--net 192.168.50.0/24 --che-do ket_hop
